import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { AppTheme, TypeScale } from "../theme.slint";

// kind: 1 friend, 2 blocked, 3 incoming request, 4 outgoing request.
export struct FriendItem {
    id: string,
    name: string,
    initials: string,
    status: string,
    kind: int,
    online: bool,
}

component FriendsTabButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <int> badge: 0;
    callback clicked();

    height: 28px;
    border-radius: 4px;
    background: root.selected ? AppTheme.interactive-selected : (tab_ta.has-hover ? AppTheme.interactive-hover : transparent);
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        Text {
            text: root.label;
            color: root.selected ? AppTheme.text-strong : AppTheme.text-secondary;
            font-size: TypeScale.small;
            font-weight: 600;
            vertical-alignment: center;
        }

        if root.badge > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 16px;
                width: root.badge > 9 ? 22px : 16px;
                border-radius: 8px;
                background: AppTheme.danger-action;

                Text {
                    text: root.badge > 99 ? "99+" : "\{root.badge}";
                    color: AppTheme.text-on-accent;
                    font-size: TypeScale.micro;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    tab_ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component FriendActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> positive: false;
    callback clicked();

    height: 30px;
    width: action_text.preferred-width + 24px;
    border-radius: 4px;
    background: root.positive
        ? (action_ta.has-hover ? AppTheme.success-hover : AppTheme.success)
        : (root.danger
            ? (action_ta.has-hover ? AppTheme.danger-action : AppTheme.danger-action-subtle)
            : (action_ta.has-hover ? AppTheme.surface-control-hover : AppTheme.interactive-muted));
    animate background { duration: 120ms; }

    action_text := Text {
        text: root.label;
        color: (root.positive || (root.danger && action_ta.has-hover)) ? AppTheme.text-on-accent : (root.danger ? AppTheme.danger : AppTheme.text-primary);
        font-size: TypeScale.small;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    action_ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component FriendsView inherits Rectangle {
    in property <[FriendItem]> items;
    // 0 Online, 1 All, 2 Pending, 3 Blocked
    in-out property <int> tab: 1;
    in property <int> pending_count;
    in property <string> status;
    in property <bool> status_is_error;
    in-out property <string> add_text;
    callback tab_changed(int);
    callback action(string /* user id */, string /* accept, ignore, remove, cancel, unblock */);
    callback add_friend(string /* username */);

    background: AppTheme.surface-sidebar;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Header with the tabs
        Rectangle {
            height: 44px;
            background: AppTheme.surface-sidebar;

            Rectangle {
                x: 0px;
                y: 8px;
                width: 1px;
                height: parent.height - 16px;
                background: AppTheme.separator;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Friends";
                        color: AppTheme.text-strong;
                        font-size: TypeScale.title;
                        font-weight: 700;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: AppTheme.separator;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    FriendsTabButton {
                        label: "Online";
                        selected: root.tab == 0;
                        clicked => { root.tab = 0; root.tab_changed(0); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    FriendsTabButton {
                        label: "All";
                        selected: root.tab == 1;
                        clicked => { root.tab = 1; root.tab_changed(1); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    FriendsTabButton {
                        label: "Pending";
                        selected: root.tab == 2;
                        badge: root.pending_count;
                        clicked => { root.tab = 2; root.tab_changed(2); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    FriendsTabButton {
                        label: "Blocked";
                        selected: root.tab == 3;
                        clicked => { root.tab = 3; root.tab_changed(3); }
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Add friend by username
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 6px;

            Text {
                text: "ADD FRIEND";
                color: AppTheme.text-muted;
                font-size: TypeScale.micro;
                font-weight: 700;
            }

            HorizontalLayout {
                spacing: 8px;

                add_input := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "Enter a username";
                    text <=> root.add_text;
                    accepted => {
                        if (self.text != "") {
                            root.add_friend(self.text);
                        }
                    }
                }

                Button {
                    text: "Send Friend Request";
                    primary: true;
                    enabled: add_input.text != "";
                    clicked => { root.add_friend(add_input.text); }
                }
            }

            if root.status != "": Text {
                text: root.status;
                color: root.status_is_error ? AppTheme.danger : AppTheme.success;
                font-size: TypeScale.small;
                wrap: word-wrap;
            }
        }

        Rectangle {
            height: 1px;
            background: AppTheme.separator;
        }

        // The list of the selected tab
        Rectangle {
            vertical-stretch: 1;

            if root.items.length == 0: Text {
                text: root.tab == 0 ? "No friends are online right now."
                    : (root.tab == 1 ? "You have no friends yet. Add one by username above."
                    : (root.tab == 2 ? "There are no pending friend requests." : "You have not blocked anyone."));
                color: AppTheme.text-muted;
                font-size: TypeScale.body;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            ScrollView {
                width: 100%;
                height: 100%;
                viewport-width: self.visible-width;

                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 4px;
                    spacing: 2px;
                    alignment: start;

                    for item in root.items: Rectangle {
                        height: 56px;
                        border-radius: 6px;
                        background: row_ta.has-hover ? AppTheme.interactive-hover : transparent;
                        animate background { duration: 120ms; }

                        row_ta := TouchArea { }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: AppTheme.accent;

                                    Text {
                                        text: item.initials;
                                        color: AppTheme.text-on-accent;
                                        font-size: TypeScale.small;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    if item.kind == 1: Rectangle {
                                        x: parent.width - self.width;
                                        y: parent.height - self.height;
                                        width: 14px;
                                        height: 14px;
                                        border-radius: 7px;
                                        background: item.online ? AppTheme.success : AppTheme.text-subtle;
                                        border-width: 3px;
                                        border-color: AppTheme.surface-sidebar;
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;

                                Text {
                                    text: item.name;
                                    color: AppTheme.text-strong;
                                    font-size: TypeScale.body;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: item.status;
                                    color: AppTheme.text-muted;
                                    font-size: TypeScale.caption;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                HorizontalLayout {
                                    spacing: 8px;

                                    if item.kind == 3: FriendActionButton {
                                        label: "Accept";
                                        positive: true;
                                        clicked => { root.action(item.id, "accept"); }
                                    }
                                    if item.kind == 3: FriendActionButton {
                                        label: "Ignore";
                                        danger: true;
                                        clicked => { root.action(item.id, "ignore"); }
                                    }
                                    if item.kind == 4: FriendActionButton {
                                        label: "Cancel";
                                        danger: true;
                                        clicked => { root.action(item.id, "cancel"); }
                                    }
                                    if item.kind == 1: FriendActionButton {
                                        label: "Remove";
                                        danger: true;
                                        clicked => { root.action(item.id, "remove"); }
                                    }
                                    if item.kind == 2: FriendActionButton {
                                        label: "Unblock";
                                        clicked => { root.action(item.id, "unblock"); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
